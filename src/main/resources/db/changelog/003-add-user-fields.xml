<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="4" author="developer">
        <addColumn tableName="users">
            <column name="firstname" type="VARCHAR(100)" remarks="Имя пользователя">
                <constraints nullable="true"/>
            </column>
            <column name="middlename" type="VARCHAR(100)" remarks="Отчество пользователя">
                <constraints nullable="true"/>
            </column>
            <column name="lastname" type="VARCHAR(100)" remarks="Фамилия пользователя">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>